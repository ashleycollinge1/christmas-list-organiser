# Copy to .env next to your compose file and fill in the blanks.

# --- Database (required) -----------------------------------------------------
POSTGRES_PASSWORD=
# POSTGRES_USER=xmas
# POSTGRES_DB=xmas

# --- Initial administrator ---------------------------------------------------
# Used ONLY on first start, when no admin exists yet. Changing it later has no
# effect: change the password in the app instead. Minimum 12 characters.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Web: network access ----------------------------------------------------
# The web UI is published on the host as  APP_BIND:APP_PORT  ->  container:8000
#
# APP_BIND: which host network address to listen on.
#   127.0.0.1    (default) Only the Docker host itself can connect. Use when your
#                reverse proxy runs on the same host, outside Docker.
#   0.0.0.0      Every network interface: reachable from other machines.
#                Use when the proxy is on another machine, or for direct LAN
#                access. Docker-published ports bypass ufw on most Linux
#                hosts, so firewall at the router/cloud level if internet-facing.
#   192.168.1.50 One specific interface, e.g. LAN only.
# If you see "running but not reachable from other machines", this is usually why.
# APP_BIND=127.0.0.1
#
# APP_PORT: the port on the host (the container always listens on 8000).
APP_PORT=8000
#
# COOKIE_SECURE: mark the login cookie "Secure" so browsers only send it over HTTPS.
#   true   (default) Correct when users reach the app via https:// (your proxy).
#   false  REQUIRED if users open the app over plain http:// (e.g. http://host:8000).
#          Browsers refuse to store a Secure cookie on an http page, so login
#          "succeeds" and is immediately lost: you'll see "Your session ended.
#          Please sign in again." on every login.
#          Plain HTTP sends passwords unencrypted: only use it on a trusted LAN.
COOKIE_SECURE=true
#
# Proxy IPs trusted for X-Forwarded-For/Proto ("*" = any; fine while the port
# is only reachable by the proxy).
# FORWARDED_ALLOW_IPS=*

# --- Backups -----------------------------------------------------------------
# Host folder for the nightly database dumps (pg_dump custom format).
BACKUP_PATH=./backups
# Local time of the nightly backup (24h HH:MM, in TZ below).
BACKUP_TIME=03:00
# Dumps older than this many days are deleted.
BACKUP_KEEP_DAYS=30
# Owner of the dump files on the host (match your user so you can read them).
# BACKUP_UID=1000
# BACKUP_GID=1000
# A dump is also taken every time the stack starts, and web (which runs database
# migrations) waits for it. Set to false ONLY to let web start when that dump fails.
# BACKUP_REQUIRED=true

# --- General -----------------------------------------------------------------
TZ=Europe/London
